+/// SPIKE S2: the `On` sponge into the eight cells at `st`, digest left in lanes 0..4 (no copy
+/// out). `zero` false skips zeroing the unreached lanes — only for a fresh, never-written `st`,
+/// whose cells read zero by the memory table's first-read rule.
+pub fn sponge_state(b: &mut Builder, st: Ptr, src: Ptr, n: usize, zero: bool) {
+    assert!(n >= 1);
+    let first = n.min(RATE);
+    if zero {
+        b.zero_cells(st, first as i64, WIDTH - first);
+    }
+    let mut done = 0;
+    while done + RATE <= n {
+        let block = b.offset(src, done as i64);
+        b.sponge_absorb(st, block);
+        done += RATE;
+    }
+    if done < n {
+        b.copy_cells(st, 0, src, done as i64, n - done);
+        b.poseidon2(st);
+    }
+}
+
