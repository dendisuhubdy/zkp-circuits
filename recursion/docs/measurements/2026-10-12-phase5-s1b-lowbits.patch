+/// SPIKE S1b: the low-bits decomposition gadget on an already-sampled `x`; returns the 65-cell
+/// buffer whose cells `0..bits` hold the index bits.
+pub fn low_bits_gadget(b: &mut Builder, x: Felt, bits: usize) -> Ptr {
+        assert!((8..=32).contains(&bits));
+        let arr = b.hint_array_padded(bits, 65 - bits);
+        let top = bits - 1;
+        let mut idx = b.get(arr, top);
+        let l = b.add_const(idx, F::NEG_ONE);
+        let p = b.mul(idx, l);
+        b.assert_zero(p, &format!("sample_bits bit {top}"));
+        for k in (0..top).rev() {
+            let bk = b.get(arr, k);
+            let l = b.add_const(bk, F::NEG_ONE);
+            let p = b.mul(bk, l);
+            b.assert_zero(p, &format!("sample_bits bit {k}"));
+            let d = b.mul_const(idx, F::TWO);
+            idx = b.add(d, bk);
+        }
+        let a = b.hint();
+        let h0 = b.hint();
+        let h1 = b.hint();
+        let u = b.hint();
+        let wa = 32 - bits;
+        b.range_load(a, 0);
+        if wa < 24 {
+            b.range_load(a, (1u64 << 24) - (1u64 << wa));
+        }
+        b.range_load(h0, 0);
+        b.range_load(h1, 0);
+        b.range_load(h1, (1u64 << 24) - (1u64 << 8));
+        let a_sh = b.mul_const(a, F::from_u64(1u64 << bits));
+        let lo = b.add(idx, a_sh);
+        let h1_sh = b.mul_const(h1, F::from_u64(1u64 << 24));
+        let hi = b.add(h0, h1_sh);
+        let d = b.add_const(hi, -F::from_u64(0xFFFF_FFFF));
+        let du = b.mul(d, u);
+        b.assert_eq(du, lo, "sample_bits canonicality");
+        let shifted = b.mul_const(hi, F::from_u64(1 << 32));
+        let sum = b.add(lo, shifted);
+        b.assert_eq(sum, x, "sample_bits decomposition");
+        arr.base
+}
