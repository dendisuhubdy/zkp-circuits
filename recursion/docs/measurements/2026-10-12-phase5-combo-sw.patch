diff --git a/recursion/tests/spike_n2.rs b/recursion/tests/spike_n2.rs
new file mode 100644
index 0000000..f4cdab1
--- /dev/null
+++ b/recursion/tests/spike_n2.rs
@@ -0,0 +1,30 @@
+//! SPIKE (throwaway): the production aggregate emulated at N = 1 and N = 2 over the one cached
+//! production fixture (fixture 0 twice for N = 2) — no proving, no new fixture. Checks the loop
+//! body (lazy bit reloads, per-leaf sponge states) is right on the second iteration too.
+mod common;
+use rand_zkvm::machine::{FriProfile, Proof};
+use recursion::dsl::Checkpoints;
+use recursion::emulator::execute;
+use recursion::programs::verify_rv32n;
+use recursion::shape::{InnerKey, InnerShape};
+use recursion::witness::WitnessTape;
+
+#[test]
+fn spike_production_aggregate_n1_n2_emulate() {
+    let p0: Proof = common::bundle_proofs(FriProfile::Production, 1).pop().unwrap().proof;
+    let shape = InnerShape::of(FriProfile::Production, p0.tier, p0.program_log_height, p0.input_log_height,
+        p0.keccak_log_height, p0.sha256_log_height, p0.public_log_height, p0.mem_log_height);
+    let key = InnerKey::of(FriProfile::Production, &shape);
+    let vp = verify_rv32n(&shape, &key, Checkpoints::Off);
+    for n in [1usize, 2] {
+        let proofs: Vec<Proof> = (0..n).map(|_| common::bundle_proofs(FriProfile::Production, 1).pop().unwrap().proof).collect();
+        let tape = WitnessTape::build_n(FriProfile::Production, &shape, &key, &proofs, &common::TEST_BINDING).unwrap();
+        let exec = execute(&vp.program, &tape.words, 1 << 24).expect("emulates");
+        let pvs: Vec<Vec<u64>> = proofs.iter().map(|p| p.public_values.clone()).collect();
+        let words = recursion::public_values::interface_words_bound(&shape, &key, &common::TEST_BINDING, &pvs);
+        assert_eq!(exec.public, recursion::public_values::public_digest(&words).to_vec());
+        let rows = exec.cpu_rows();
+        println!("SPIKE production N={n} aggregate: {rows} cpu rows (tier {:?}), {} perms, {} witness words, max addr {}",
+            recursion::machine::Tier::for_cycles(rows), exec.permutations(), tape.words.len(), exec.max_addr);
+    }
+}
